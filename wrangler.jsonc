{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shunji",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shunji.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["23 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shunji",
      "database_id": "87257b64-c0c3-4d7a-bc6c-93c368945f4e",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
